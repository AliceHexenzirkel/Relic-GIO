<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Relic.Core</RootNamespace>
    <AssemblyName>Relic.Core</AssemblyName>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!-- English strings embedded as the ultimate fallback for Util/L (the uninstaller, the "play"
       process and the spikes must work without a ui/ folder next to them). The UI reads the same
       file from ui/lang/ at runtime; other languages overlay it. -->
  <ItemGroup>
    <EmbeddedResource Include="..\Relic.App\ui\lang\en.json" LogicalName="Relic.Core.lang.en.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
  </ItemGroup>

  <!-- Ship-build defaults baked in by build/publish.ps1 (-p:RelicDefaultServer= / -p:RelicAgentToken=),
       read at runtime via Util/BuildDefaults. Absent in plain dev builds. -->
  <ItemGroup>
    <AssemblyMetadata Include="Relic.DefaultServer" Value="$(RelicDefaultServer)" Condition="'$(RelicDefaultServer)' != ''" />
    <!-- base64(JSON [{label,host}]) — MSBuild splits -p: values on ';', so the list cannot travel as text. -->
    <AssemblyMetadata Include="Relic.DefaultServersB64" Value="$(RelicDefaultServersB64)" Condition="'$(RelicDefaultServersB64)' != ''" />
    <AssemblyMetadata Include="Relic.AgentToken" Value="$(RelicAgentToken)" Condition="'$(RelicAgentToken)' != ''" />
    <AssemblyMetadata Include="Relic.DefaultMode" Value="$(RelicDefaultMode)" Condition="'$(RelicDefaultMode)' != ''" />
  </ItemGroup>

</Project>
