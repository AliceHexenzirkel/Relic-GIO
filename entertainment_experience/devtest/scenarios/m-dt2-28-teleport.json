{
  "name": "m-dt2-28-teleport",
  "version": "2.8",
  "description": "M-DT2 on 2.8: teleports with their arrival decided in-process (direct and through the map), relative to where the character stands, and back.",
  "server": {"expectHost": "${RELIC_DEVTEST_HOST}", "agent": "${RELIC_DEVTEST_AGENT}", "tokenEnv": "RELIC_DEVTEST_TOKEN"},
  "runner": {"window": "1600x900", "ownFiles": "keep"},
  "config": {"Debug": {"DevTest": {"Enabled": true}}, "General": {"Logging": {"FileLogging": true}}},
  "session": {"noFaults": true, "maxPresentStall": 2.0},
  "steps": [
    {"label": "in the world", "op": "wait", "until": {"inGame": true, "sceneNot": 0}, "timeout": 900},
    {"include": "steps/teleport.json"},
    {"label": "quit", "op": "quit"}
  ]
}
